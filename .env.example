# ========================
# API Keys (Required)
# ========================

# Groq API Key — required for Whisper transcription and LLM inference
# Get yours at: https://console.groq.com
GROQ_API_KEY=""

# Porcupine Access Key — required for wake word detection
# Get yours at: https://picovoice.ai (free tier available)
PORCUPINE_ACCESS_KEY=""

# The bundled Jasper Porcupine model is Linux-only.  Wake-word detection
# defaults to enabled on Linux and disabled elsewhere.  Set to false to use
# the overlay text input without initializing microphone or wake-word services.
# WAKE_WORD_ENABLED=false

# ========================
# API Keys (Optional)
# ========================

# Alternative LLM providers (only needed if you switch from Groq)
TOGETHER_API_KEY=""
GOOGLE_API_KEY=""

# Tavily API Key — enables the web search tool
# Get yours at: https://tavily.com
TAVILY_API_KEY=""

# ========================
# LLM Configuration
# ========================

# qwen/qwen3.8-27b supports Groq chat, image input, and local function calls.
LLM_PROVIDER="groq"
LLM_MODEL="qwen/qwen3.8-27b"
LLM_TEMPERATURE="0.8"

# Groq speech-to-text configuration. whisper-large-v3-turbo is the current
# low-latency successor to the retired distil-whisper-large-v3-en.
TRANSCRIPTION_MODEL="whisper-large-v3-turbo"
TRANSCRIPTION_LANGUAGE="en"
TRANSCRIPTION_TIMEOUT="30"

# Optional persistent LangGraph conversation identifier.
JASPER_THREAD_ID="jasper"

# ========================
# Logging
# ========================

LOG_LEVEL=DEBUG

# ========================
# LangSmith Tracing (Optional)
# ========================

# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
# LANGSMITH_API_KEY=""
# LANGSMITH_PROJECT=""

# ========================
# Personalization
# ========================

# Customize the assistant's identity and your profile
ASSISTANT_NAME="Jasper"
OWNER_NAME="Your Name"
OWNER_AGE=""
OWNER_LOCATION=""
OWNER_OCCUPATION=""
OWNER_COLLEGE=""
OWNER_INTERESTS=""

# ========================
# Python Path
# ========================

PYTHONPATH=.

# ========================
# Mobile Device (Optional)
# For connecting to Android devices via ADB
# ========================

# MOBILE_HOST=""
# MOBILE_PORT=5555
# ADB_HOST="127.0.0.1"
# ADB_PORT=5037
